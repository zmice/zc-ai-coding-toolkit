{
  "name": "zc-ai-coding-toolkit-workspace",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --dir apps/cli dev",
    "lint": "node scripts/run-workspace-task.mjs lint",
    "test": "node scripts/run-workspace-task.mjs test",
    "build": "node scripts/run-workspace-task.mjs build",
    "generate": "node scripts/run-workspace-task.mjs generate",
    "verify": "node scripts/run-workspace-task.mjs verify",
    "verify:mvp": "node scripts/verify-workspace.mjs",
    "audit:context": "node scripts/content-budget-audit.mjs",
    "test:audit-context": "node --test scripts/content-budget-audit.test.mjs",
    "test:skill-evals": "node --test tests/skill-evals/runner.test.mjs tests/skill-evals/codex-capture.test.mjs tests/skill-evals/review-coverage-cases.test.mjs",
    "eval:skills": "node scripts/skill-evals.mjs",
    "eval:review": "node scripts/skill-evals-review-study.mjs",
    "audit:distribution": "node scripts/skill-distribution-audit.mjs",
    "test:distribution": "node --test tests/skill-distribution/audit.test.mjs",
    "test:visual-refinement": "node --test tests/visual-refinement/*.test.mjs",
    "upstream": "node scripts/upstream-governance.mjs",
    "changeset": "changeset",
    "release:check": "node scripts/release-check.mjs pre-version",
    "release:check:post-version": "node scripts/release-check.mjs post-version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4"
  }
}
