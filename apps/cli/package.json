{
  "name": "@zmice/zc",
  "version": "0.13.0",
  "description": "Unified CLI for installing, updating, and querying zc AI coding workflows across Codex, Claude Code, OpenCode, Qwen, and Qoder CN",
  "homepage": "https://github.com/zmice/zc-ai-coding-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmice/zc-ai-coding-toolkit.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/zmice/zc-ai-coding-toolkit/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "codex",
    "claude-code",
    "opencode",
    "qwen",
    "qoder-cn",
    "workflow",
    "agents",
    "skills",
    "commands",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "zc": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/**",
    "!vendor/**/dist/**/*.test.*",
    "!vendor/**/dist/**/__tests__/**"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsc --watch",
    "test": "node ./scripts/ensure-internal-builds.mjs && pnpm run test:built",
    "test:built": "vitest run src",
    "lint": "tsc --noEmit",
    "generate": "pnpm build",
    "verify": "pnpm lint && pnpm build && pnpm run test:built",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zmice/platform-codex": "workspace:*",
    "@zmice/platform-claude": "workspace:*",
    "@zmice/platform-core": "workspace:*",
    "@zmice/platform-opencode": "workspace:*",
    "@zmice/platform-qwen": "workspace:*",
    "@zmice/toolkit": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
