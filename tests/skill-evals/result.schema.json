{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline skill evaluation result",
  "type": "object",
  "required": ["fixtureId", "fixtureHash", "oracleHash", "sourceHash", "contentHash", "host", "model", "effort", "permissions", "effectiveSkills", "status", "eventStream", "events", "fileDiff", "elapsedMs", "turns", "usage", "arm", "repeat", "selection", "behavior", "outcome", "reasons"],
  "properties": {
    "fixtureId": {"type":"string"},
    "fixtureHash": {"$ref":"#/$defs/hash"},
    "oracleHash": {"$ref":"#/$defs/hash"},
    "sourceHash": {"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "contentHash": {"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "host": {"anyOf":[{"type":"object","required":["surface","version"],"properties":{"surface":{"type":"string"},"version":{"type":"string"}}},{"type":"null"}]},
    "model": {"type":["string","null"]},
    "effort": {"type":["string","null"]},
    "permissions": {"type":["string","object","null"]},
    "effectiveSkills": {"type":["array","null"],"items":{"type":"string"}},
    "controlledSkills": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "status": {"type":["string","null"]},
    "eventStream": {"type":["string","null"]},
    "events": {"type":["array","null"],"items":{"type":"object"}},
    "fileDiff": {"type":["array","null"],"items":{"type":"object","required":["path","status"],"properties":{"path":{"type":"string"},"status":{"type":"string"}}}},
    "elapsedMs": {"type":["number","null"]},
    "turns": {"type":["integer","null"]},
    "usage": {"type":["object","null"]},
    "arm": {"type":["string","null"],"enum":["baseline","candidate","no-skill",null]},
    "repeat": {"type":["integer","null"],"minimum":1,"maximum":3},
    "selection": {"$ref":"#/$defs/layer"},
    "behavior": {"$ref":"#/$defs/layer"},
    "outcome": {"enum":["pass","fail","inconclusive"]},
    "reasons": {"type":"array","items":{"type":"string"}}
  },
  "$defs": {
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "layer": {"type":"object","required":["status","reasons"],"properties":{"status":{"enum":["pass","fail","inconclusive"]},"reasons":{"type":"array","items":{"type":"string"}}}}
  }
}
